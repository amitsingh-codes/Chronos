# ScoreMatrix backend configuration.
# Copy to ".env" (never commit .env) and edit. Placeholder values only - no real secrets here.
# Every setting is optional except GEMINI_API_KEY for the AI-powered endpoints.

# ------------------------------------------------------------------ application
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list (or a JSON array) of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------------------------------------------------- Gemini
# Get a key at https://aistudio.google.com/apikey . Never paste a real key into this example file.
GEMINI_API_KEY=your_api_key
# Gemini 2.5 models were scheduled for shutdown on 2026-10-16; check
# https://ai.google.dev/gemini-api/docs/deprecations for the model you choose.
GEMINI_MODEL=gemini-3.8-flash
# Leave blank to use the model default (recommended by Google for Gemini 3.x).
GEMINI_TEMPERATURE=
GEMINI_MAX_OUTPUT_TOKENS=16384
# Gemini 3.x thinking depth: minimal | low | medium | high. Blank = model default.
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT_SECONDS=90
# Retries (exponential backoff + jitter) apply only to transient errors: 429, 5xx, timeouts, connection errors.
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_SECONDS=1.0
GEMINI_RETRY_MAX_DELAY_SECONDS=20
# Extra attempts if the model returns JSON that fails validation.
GEMINI_MAX_PARSE_RETRIES=1
# Maximum simultaneous Gemini calls across the whole server.
GEMINI_MAX_CONCURRENCY=4

# ---------------------------------------------------------------- request limits
# Whole request body (all uploaded files together).
MAX_REQUEST_SIZE_MB=64
MAX_JSON_BODY_SIZE_MB=5
# In-memory, per-process sliding window per client address, applied to /api/*.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Only enable behind a reverse proxy you control; otherwise clients can spoof X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# -------------------------------------------------------------------------- PDF
MAX_PDF_SIZE_MB=20
MAX_TEXT_FILE_SIZE_MB=2
# Pages beyond this are not read (the result is flagged truncated).
MAX_PDF_PAGES=100
PDF_PROCESSING_TIMEOUT_SECONDS=180
PDF_MAX_CONCURRENT_EXTRACTIONS=2
# A page with fewer letters/digits than this is treated as image-only and sent to OCR.
MIN_CHARS_PER_PAGE=25

# -------------------------------------------------------------------------- OCR
OCR_ENABLED=true
# Tesseract language codes joined with "+", e.g. eng+hin (each needs its traineddata installed).
OCR_LANGUAGES=eng
OCR_DPI=200
# Maximum pages OCR'd per PDF (0 disables OCR).
OCR_MAX_PAGES=30
OCR_TIMEOUT_SECONDS_PER_PAGE=60
OCR_MAX_IMAGE_PIXELS=40000000
# Only needed if tesseract is not on PATH. WINDOWS: use single quotes or forward slashes.
# Do NOT use double quotes with backslashes - "\t" in "...\tesseract.exe" becomes a TAB.
# TESSERACT_CMD='C:\Program Files\Tesseract-OCR\tesseract.exe'
TESSERACT_CMD=

# -------------------------------------------------------------------- embeddings
# sentence-transformers = real semantic embeddings (downloads the model on first use).
# hashing = lexical fallback (no download, NOT semantic; for low-resource/dev use).
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_TEXTS=4000

# --------------------------------------------------------------------- questions
QUESTION_MAX_SOURCE_CHARS=30000
# true = drop questions whose source excerpt cannot be found verbatim; false = keep and flag them.
QUESTION_REQUIRE_VERIFIED_EVIDENCE=false

# ------------------------------------------------------------------- evaluation
EVAL_MAX_ANSWER_CHARS=30000
EVAL_MAX_QUESTION_CHARS=15000
BATCH_MAX_FILES=20
BATCH_CONCURRENCY=3
BATCH_PER_FILE_TIMEOUT_SECONDS=240

# ------------------------------------------------------------------- plagiarism
PLAGIARISM_MAX_DOCUMENTS=10
PLAGIARISM_MAX_CHARS_PER_DOCUMENT=200000
PLAGIARISM_SHINGLE_SIZE=5
PLAGIARISM_MIN_WORDS=30
PLAGIARISM_SEMANTIC_THRESHOLD=0.85
PLAGIARISM_NEAR_DUPLICATE_THRESHOLD=0.85
PLAGIARISM_MAX_MATCHES=25

# -------------------------------------------------------------------------- RAG
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MAX_TOP_K=20
RAG_MAX_DOCUMENTS=10
RAG_MAX_CHUNKS=2000
RAG_MAX_CHARS_PER_DOCUMENT=500000
# Relevance floor for semantic embeddings (cosine). Below it, no answer is generated. Tune per model.
RAG_MIN_SIMILARITY=0.25
